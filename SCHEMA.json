{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argentina Travel Archive and Project 23 Record",
  "description": "Schema for records in the Argentina Travel Archive and Project 23 dataset.",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "section",
    "title"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Stable record identifier."
    },
    "record_type": {
      "type": "string",
      "description": "Record category.",
      "enum": [
        "archive_intro",
        "archive_methodology",
        "blog_post",
        "content_index",
        "image_meta",
        "media_reference",
        "media_references_index",
        "photo_metadata_index",
        "youtube_index",
        "youtube_video_transcript"
      ]
    },
    "section": {
      "type": "string",
      "description": "Broad dataset section.",
      "enum": [
        "content",
        "intro",
        "media_references",
        "photos",
        "youtube"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable record title."
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Public URL when available."
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical public URL when available."
    },
    "site": {
      "type": [
        "string",
        "null"
      ],
      "description": "Website or publication name when applicable."
    },
    "site_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "Short site code when applicable."
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Content type for article/page records."
    },
    "channel_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "YouTube channel name when applicable."
    },
    "channel_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "YouTube channel code when applicable."
    },
    "video_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "YouTube video ID when applicable."
    },
    "platform": {
      "type": [
        "string",
        "null"
      ],
      "description": "Platform name for media/photo records."
    },
    "image_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Image identifier when applicable."
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Publication timestamp or date when available."
    },
    "taken_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Photo capture timestamp when available."
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "description": "Language code or label."
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Record text when available."
    },
    "source_metadata": {
      "type": [
        "object",
        "null"
      ],
      "description": "Source file or extraction metadata when available."
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 checksum for text or payload where provided."
    },
    "sha256_transcripts": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 checksum for transcript payloads where provided."
    },
    "sha256_meta_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 checksum for photo metadata text where provided."
    }
  },
  "additionalProperties": true
}